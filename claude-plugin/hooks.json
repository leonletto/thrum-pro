{
  "thrum": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./scripts/agy-session-start.sh",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "./hooks/memory-pointer/hook.sh --out mark",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "./hooks/memory-pointer/hook.sh --out emit",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./scripts/agy-stop-inbox.sh",
        "timeout": 15
      }
    ]
  }
}
