{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "type": "command",
        "command": "${CURSOR_PLUGIN_ROOT}/scripts/block-sync-worktree-cd.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "${CURSOR_PLUGIN_ROOT}/scripts/block-tls-key-exfil.sh",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "${CURSOR_PLUGIN_ROOT}/scripts/memory-pointer.sh --out cursor",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "${CURSOR_PLUGIN_ROOT}/scripts/stop-check-messages.sh",
        "timeout": 15
      }
    ],
    "preCompact": []
  }
}
