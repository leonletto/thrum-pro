{
  "version": 1,
  "_supersedes": "the earlier watcher-settings allowlist spec (single-watcher restart-flow scope)",
  "command_patterns": [
    "thrum"
  ],
  "read_paths": [
    ".claude/skills",
    ".claude/commands",
    ".codex/skills",
    ".opencode/skills",
    ".thrum"
  ],
  "global_read_paths": {
    "claude": [
      "~/.claude/plugins/cache/thrum",
      "~/.local/bin"
    ],
    "codex": [
      "~/.codex/skills",
      "~/.codex/plugins/cache/thrum-marketplace/thrum",
      "~/.local/bin"
    ],
    "opencode": [
      "~/.local/bin"
    ]
  },
  "owner_authorized_exceptions": {
    "claude": [
      "/private/tmp"
    ],
    "codex": [
      "/private/tmp"
    ],
    "opencode": [
      "/private/tmp"
    ]
  }
}
