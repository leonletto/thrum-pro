{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "./scripts/inject-prime-context.sh",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "type": "command",
        "command": "./scripts/block-sync-worktree-cd.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "./scripts/block-tls-key-exfil.sh",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "./scripts/stop-check-messages.sh",
        "timeout": 15
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "command": "./scripts/pre-compact-save-context.sh 2>/dev/null || true"
      }
    ],
    "postCompact": [
      {
        "type": "command",
        "command": "./scripts/post-compact-recover.sh",
        "timeout": 10
      }
    ]
  }
}
